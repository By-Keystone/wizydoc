{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["bin/**", "lib/**", "test/**", "*.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "html": { "parser": { "interpolation": true } },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}

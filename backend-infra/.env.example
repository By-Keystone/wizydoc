# Copia este archivo a .env para `pnpm cdk synth` y `pnpm cdk deploy` en local.
# En GitHub Actions estas variables llegan del entorno, y dotenv no las pisa.

# Zona de Route53 del dominio y subdominio del api: el api queda en API_SUBDOMAIN.DOMAIN.
HOSTED_ZONE_ID=Z0000000000000000000
DOMAIN=wizydoc.app
API_SUBDOMAIN=api

# Origen de platform, sin ruta (esquema, host y puerto): base de los enlaces de los
# correos (/verify-email, /login, /forgot-password). Una ruta se perdería en los enlaces.
FRONTEND_URL=http://localhost:3000

# Remitente de los correos. Su dominio tiene que ser una identidad verificada en SES (us-east-2): el permiso de envío se da sobre ella.
EMAIL_FROM=WizyDoc <no-reply@wizydoc.app>

# Aceptación de los términos en el registro. Sólo "true" la enciende.
TERMS_ACCEPTANCE_REQUIRED=false

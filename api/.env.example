DATABASE_URL=postgresql://wizydoc:wizydoc@localhost:5432/wizydoc
JWT_SECRET=change-this-to-a-secure-random-string
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Huso en el que operan las clínicas: convierte las horas de reloj de la agenda
# a instantes. Provisional hasta que cada Clinic tenga el suyo.
CLINIC_TIME_ZONE=America/Lima

# AWS SES (local: AWS_PROFILE from `aws configure sso`; App Runner: IAM role)
AWS_PROFILE=wizydoc
AWS_REGION=us-east-1
EMAIL_FROM=test@test.com
BETTER_AUTH_SECRET=secret

# Better Auth: origen público desde el que se sirve /api/auth (el frontend, que
# lo reenvía al api con un rewrite). Con él se construyen los enlaces de los
# correos de confirmación.
BETTER_AUTH_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Billing (Culqi). Sin /v2: las rutas ya lo incluyen.
CULQI_API_BASE_URL=https://api.culqi.com
CULQI_API_PRIVATE_KEY=sk_test_xxx
# Ids de los planes creados en Culqi (panel o CulqiBillingService.createPlan).
CULQI_PLAN_ID_CONSULTORIO=pln_test_xxx
CULQI_PLAN_ID_CLINICA=pln_test_xxx

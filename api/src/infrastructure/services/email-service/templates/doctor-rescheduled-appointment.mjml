<mjml>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">Hola {{doctorName}},</mj-text>
        <mj-text font-size="16px">
          Tu paciente reprogramó su cita desde el enlace de autogestión.
        </mj-text>
        <mj-table font-size="15px" cellpadding="0">
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Antes</td>
            <td style="padding: 8px 0;"><s>{{previousScheduledAt}}</s></td>
          </tr>
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Ahora</td>
            <td style="padding: 8px 0; font-weight: bold;">{{scheduledAt}}</td>
          </tr>
          {{#if previousDoctorName}}
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Médico anterior</td>
            <td style="padding: 8px 0;">{{previousDoctorName}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Médico nuevo</td>
            <td style="padding: 8px 0; font-weight: bold;">{{newDoctorFullName}}</td>
          </tr>
          {{/if}}
        </mj-table>
        <mj-text font-size="16px" font-weight="bold">Nueva cita</mj-text>
        <mj-table font-size="15px" cellpadding="0">
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Fecha y hora</td>
            <td style="padding: 8px 0;">{{scheduledAt}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Duración</td>
            <td style="padding: 8px 0;">{{durationMinutes}} minutos</td>
          </tr>
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Especialidad</td>
            <td style="padding: 8px 0;">{{specialty}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Profesional</td>
            <td style="padding: 8px 0;">{{newDoctorFullName}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 16px 8px 0; color: #5C6B6A;">Sede</td>
            <td style="padding: 8px 0;">{{clinicName}}</td>
          </tr>
        </mj-table>
        <mj-text font-size="14px" color="#5C6B6A">
          No tienes que hacer nada. Consulta tu agenda en WizyDoc para ver el detalle.
        </mj-text>
        <mj-button background-color="#0E8C82" href="{{agendaUrl}}">
          Ver mi agenda
        </mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

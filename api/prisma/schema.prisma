generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(uuid(7)) @db.Uuid
  email               String   @unique
  name                String
  lastName            String   @map("last_name")
  phone               String
  role                UserRole @default(USER) // Account Role
  confirmed           Boolean  @default(false)
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  accountId           String?  @map("account_id") @db.Uuid

  doctorProfile       DoctorProfile[]
  resourcesCreated    Resource[]
  resourceMemberships UserResourceMembership[] @relation(name: "user_membership")
  membershipsCreated  UserResourceMembership[] @relation(name: "memberships_created")

  image               String?
  sessions            Session[]
  authaccounts        AuthAccount[]
  userInvitationsSent UserInvitation[]

  @@map("user")
}

model Resource {
  id               String       @id @default(uuid(7)) @db.Uuid
  type             ResourceType
  parentResourceId String?      @map("parent_resource_id") @db.Uuid
  createdBy        String       @map("created_by") @db.Uuid
  accountId        String       @map("account_id") @db.Uuid

  parent              Resource?                @relation("ResourceTree", fields: [parentResourceId], references: [id])
  children            Resource[]               @relation("ResourceTree")
  organization        Organization?
  clinic              Clinic?
  resourceMemberships UserResourceMembership[]
  createdByUser       User                     @relation(fields: [createdBy], references: [id])
  account             Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
  @@map("resource")
}

model Organization {
  resourceId String   @id @map("resource_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  resource    Resource    @relation(fields: [resourceId], references: [id])
  accountId   String      @map("account_id") @db.Uuid
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  specialties Specialty[]

  @@unique([accountId, name])
  @@map("organization")
}

model Clinic {
  resourceId String   @id @map("resource_id") @db.Uuid
  name       String
  address    String
  phone      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  resource     Resource        @relation(fields: [resourceId], references: [id])
  doctors      DoctorProfile[]
  appointments Appointment[]

  @@map("clinic")
}

model UserResourceMembership {
  id            String          @id @default(uuid(7)) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  resourceId    String          @map("resource_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  createdBy     String          @map("created_by") @db.Uuid
  role          MembershipRole  @default(USER) // Membership Role
  account       Account         @relation(fields: [accountId], references: [id])
  user          User            @relation(fields: [userId], references: [id], name: "user_membership")
  resource      Resource        @relation(fields: [resourceId], references: [id])
  createdByUser User            @relation(fields: [createdBy], references: [id], name: "memberships_created")
  invitation    UserInvitation?
  deletedAt     DateTime?       @map("deleted_at")

  @@unique([userId, resourceId])
  @@index([accountId, role])
  @@map("user_resource_membership")
}

model DoctorProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clinicId  String   @map("resource_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic   @relation(fields: [clinicId], references: [resourceId], onDelete: NoAction)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  availabilities Availability[]
  specialties    Specialty[]
  appointments   Appointment[]

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("doctor_profile")
}

model Subscription {
  id        String             @id @default(uuid(7)) @db.Uuid
  accountId String             @unique @map("account_id") @db.Uuid
  status    SubscriptionStatus
  plan      Plan

  extraDoctors Int @default(0) @map("extra_doctors")
  extraClinics Int @default(0) @map("extra_clinics")

  // Nulos en los planes que no se cobran (Gratis, Red).
  paymentProviderCustomerId     String? @map("payment_provider_customer_id")
  paymentProviderCardId         String? @map("payment_provider_card_id")
  paymentProviderSubscriptionId String? @unique @map("payment_provider_subscription_id")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  addOns  AddOn[]

  @@map("subscription")
}

model AddOn {
  id             String       @id @default(uuid(7)) @db.Uuid
  type           AddOnType
  subscriptionId String       @map("subscription_id") @db.Uuid
  amount         Int
  quantity       Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  paymentProviderSubscriptionId String @map("payment_provider_subscriptioin_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  cancelledAt DateTime? @map("cancelled_at")

  @@index([paymentProviderSubscriptionId])
  @@map("add_on")
}

model Account {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  subscription            Subscription?
  userResourceMemberships UserResourceMembership[]
  resources               Resource[]
  patients                Patient[]
  organizations           Organization[]

  @@map("account")
}

model UserInvitation {
  id           String                 @id @default(uuid(7)) @db.Uuid
  token        String                 @unique
  membershipId String                 @unique @map("membership_id") @db.Uuid
  invitedBy    String                 @map("invited_by") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")
  expiresAt    DateTime               @map("expires_at")
  acceptedAt   DateTime?              @map("accepted_at")
  status       InvitationStatus       @default(INVITED)
  inviter      User                   @relation(fields: [invitedBy], references: [id], onDelete: NoAction)
  membership   UserResourceMembership @relation(fields: [membershipId], references: [id], onDelete: NoAction)

  @@map("user_invitation")
}

model Availability {
  id              String @id @default(uuid(7)) @db.Uuid
  doctorProfileId String @map("doctor_profile_id") @db.Uuid
  dayOfWeek       Int    @map("day_of_week") // 0=Sunday, 6=Saturday
  startTime       String @map("start_time") // "09:00"
  endTime         String @map("end_time") // "17:00"

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: NoAction)

  @@index([doctorProfileId])
  @@map("doctor_schedule")
}

model Specialty {
  id             String @id @default(uuid(7)) @db.Uuid
  name           String @unique
  organizationId String @map("organization_id") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [resourceId], onDelete: NoAction)
  doctorProfiles DoctorProfile[]

  @@map("specialty")
}

model Appointment {
  id              String            @id @default(uuid(7)) @db.Uuid
  doctorProfileId String            @map("doctor_profile_id") @db.Uuid
  clinicId        String            @map("clinic_id") @db.Uuid
  patientId       String            @map("patient_id") @db.Uuid
  scheduledAt     DateTime          @map("scheduled_at")
  status          AppointmentStatus @default(PENDING)
  durationMinutes Int               @map("duration_minutes")
  specialty       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: NoAction)
  clinic        Clinic        @relation(fields: [clinicId], references: [resourceId], onDelete: NoAction)
  patient       Patient       @relation(fields: [patientId], references: [id])

  @@unique([doctorProfileId, scheduledAt])
  @@index([scheduledAt])
  @@index([patientId, scheduledAt])
  @@map("appointment")
}

enum UserRole {
  ADMIN
  USER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ResourceType {
  ORGANIZATION
  CLINIC
}

enum SubscriptionStatus {
  CANCELLED
  ACTIVE
}

enum Plan {
  FREE
  CONSULTORIO
  CLINICA
  RED
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model AuthAccount {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("authAccount")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Patient {
  id             String @id @default(uuid(7)) @db.Uuid
  name           String
  lastName       String @map("last_name")
  email          String
  phone          String
  documentNumber String @map("document_number")
  documentType   String @map("document_type")
  accountId      String @map("account_id") @db.Uuid

  birthDate        String? @map("birth_date")
  sex              String?
  emergencyContact String? @map("emergency_contact")
  insurer          String?

  bloodType   String?  @map("blood_type")
  allergies   String[]
  background  String?
  medications String?

  // Sin esto una lista de alergias vacía significa a la vez "no tiene" y "nadie
  // se lo ha preguntado todavía", que clínicamente no es lo mismo.
  allergiesReviewedAt DateTime? @map("allergies_reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  account Account @relation(fields: [accountId], references: [id], onDelete: NoAction)

  appointments Appointment[]

  @@unique([accountId, documentType, documentNumber])
  @@index([accountId, documentNumber])
  @@map("patient")
}

enum InvitationStatus {
  INVITED
  ACCEPTED
  EXPIRED
}

enum MembershipRole {
  ADMIN
  DOCTOR
  USER
}

enum AddOnType {
  DOCTOR_SEAT
  CLINIC_SEAT
}

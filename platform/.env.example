API_URL=
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxx
# Backend de platform: "api" (por defecto) o "serverless". Con "serverless", platform usa backend-infra en vez del api de API_URL; cualquier otro valor (o vacío) cuenta como "api".
BACKEND=api
# Origen del API Gateway de backend-infra, por ejemplo https://api.wizydoc.app. Sólo lo usa el servidor.
BACKEND_API_URL=
# Clave de API Gateway de platform (output PlatformApiKeyId de backend-infra). Nunca con NEXT_PUBLIC_.
BACKEND_API_KEY=
